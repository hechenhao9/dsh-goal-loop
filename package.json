{
  "name": "dsh-goal-loop",
  "version": "1.5.0",
  "type": "module",
  "description": "目标工程三层闸门 for DeepSeek Harness：机器层（命令能判的全绿）+ 评审层（独立判分过线、无红线）+ 校准层（盲预测押注、判完对账、换尺子留理由）。",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./lib/goal-core.mjs": "./lib/goal-core.mjs",
    "./lib/rubric-core.mjs": "./lib/rubric-core.mjs",
    "./lib/calibration-core.mjs": "./lib/calibration-core.mjs",
    "./client": "./lib/client.js"
  },
  "files": [
    "index.mjs",
    "bin",
    "lib",
    "skill",
    "agents",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "install.ps1",
    "uninstall.ps1",
    "rubric.example.json"
  ],
  "bin": {
    "goal-loop": "./bin/goal.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "filesystem:read",
      "filesystem:write",
      "process:spawn"
    ],
    "capability": {
      "id": "goal-loop",
      "kind": "skill+tools+command",
      "invocation": "skill goal-loop / /goal / /review",
      "expected": "技能目录出现 goal-loop（外加 goal-professor / goal-tutor / goal-reviewer 三个角色稿）；工具列表出现 goal_define / goal_check / goal_predict / goal_review / goal_retro / goal_verdict / goal_doctor / goal_status / goal_mode 九个工具；.goal/<id>/ 下落盘 goal.json / proof-N.json / predict-N.json / review-N.json / retro-N.json / gate.json；goal_define 在目标含「借鉴/参考/复刻」时会要求 provenance 与 refusals。"
    }
  },
  "scripts": {
    "test": "node --test",
    "demo": "node bin/goal.mjs demo"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "goal-engineering",
    "rubric",
    "gate",
    "calibration",
    "blind-prediction",
    "provenance"
  ],
  "author": "hechenhao9",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hechenhao9/dsh-goal-loop.git"
  },
  "homepage": "https://github.com/hechenhao9/dsh-goal-loop#readme",
  "bugs": {
    "url": "https://github.com/hechenhao9/dsh-goal-loop/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  }
}
